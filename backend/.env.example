# Direct PostgreSQL connection URL (used by `prisma migrate` / CLI)
postgress_url="postgresql://USER:PASSWORD@HOST:PORT/DB"

# Prisma Accelerate connection URL (used by the Hono app at runtime via @prisma/extension-accelerate)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_KEY"

# Secret used to sign/verify JWTs (HS256). Use a long random string.
JWT_SECRET="change-me-to-a-long-random-secret"
